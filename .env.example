# Schemint Configuration
# Copy this file to .env and update values

# Application
ENV=development
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# AI (Optional - enables advanced analysis)
# Get your API key from: https://console.anthropic.com/
CLAUDE_API_KEY=

# Analysis
MAX_SQL_LENGTH=100000
DEFAULT_DATABASE_TYPE=mysql

# Database (Memory Store) - REQUIRED
# PostgreSQL connection string
# Example: postgresql://user:password@localhost:5432/schemint
DATABASE_URL=postgresql://schemint:schemint123@localhost:5432/schemint
